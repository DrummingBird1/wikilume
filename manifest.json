{
  "manifest_version": 3,
  "name": "WikiFree – Clean Wikipedia Reader",
  "short_name": "WikiFree",
  "version": "1.0.0",
  "description": "A clean, modern reading experience for Wikipedia. Free, no accounts, no subscriptions. קריאה נקייה ומודרנית בוויקיפדיה – הכול בחינם.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "WikiFree",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.wikipedia.org/*"],
      "exclude_matches": ["*://*.m.wikipedia.org/*"],
      "js": ["src/i18n.js", "src/bookmarks.js", "src/content.js"],
      "css": ["src/reader.css"],
      "run_at": "document_start"
    }
  ]
}
