{
  "name": "wikilume",
  "version": "1.0.0",
  "private": true,
  "description": "Clean, modern reading experience for Wikipedia (browser extension). Free, no accounts, no subscriptions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/check.js",
    "test": "node --test test/*.test.js",
    "verify": "node tools/check.js && node --test test/*.test.js",
    "e2e": "node test/e2e/run.js",
    "pack": "node tools/pack.js",
    "icons": "node tools/make-icons.js",
    "site": "node tools/build-site.js",
    "check-store": "node tools/check-store.js",
    "screenshots": "node tools/make-screenshots.js && node tools/make-promo.js"
  }
}
